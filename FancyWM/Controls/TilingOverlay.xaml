<UserControl x:Class="FancyWM.Controls.TilingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FancyWM.Controls"
             xmlns:util="clr-namespace:FancyWM.Utilities"
             xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingOverlayViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Canvas>
        <Canvas.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <!-- Bind to SystemAccentColor so cues follow Windows accent when
                 accent override is disabled, and app accent when enabled. -->
            <SolidColorBrush x:Key="DropCueStrokeBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="DropCueFillBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.33" />
        </Canvas.Resources>
        <ItemsControl ItemsSource="{Binding Path=PanelElements}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TilingPanel
                        ViewModel="{Binding}"
                        Visibility="{Binding Path=IsHeaderVisible, Converter={StaticResource BoolToVis}}"
                        util:Draggable.IsDraggable="True">
                        <local:TilingPanel.Style>
                            <Style TargetType="FrameworkElement">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                        <DataTrigger.Setters>
                                            <Setter Property="Cursor" Value="../Resources/hand_grabbing.cur" />
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:TilingPanel.Style>
                    </local:TilingPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Path=HeaderBounds.Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Path=HeaderBounds.Top}" />
                    <Setter Property="Width" Value="{Binding Path=HeaderBounds.Width}" />
                    <Setter Property="Height" Value="{Binding Path=HeaderBounds.Height}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Path=WindowElements}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TilingWindow ViewModel="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Path=ComputedBounds.Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Path=ComputedBounds.Top}" />
                    <Setter Property="Width" Value="{Binding Path=ComputedBounds.Width}" />
                    <Setter Property="Height" Value="{Binding Path=ComputedBounds.Height}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Fallback drop cue layer with plain brushes (no theme resources/effects). -->
        <Canvas Panel.ZIndex="5000" IsHitTestVisible="False">
            <Rectangle
                Fill="Transparent"
                Stroke="{StaticResource DropCueStrokeBrush}"
                StrokeThickness="2"
                RadiusX="8"
                RadiusY="8"
                Width="{Binding DropZoneOutlineRect.Width}"
                Height="{Binding DropZoneOutlineRect.Height}"
                Canvas.Left="{Binding DropZoneOutlineRect.Left}"
                Canvas.Top="{Binding DropZoneOutlineRect.Top}" />
            <Rectangle Fill="{StaticResource DropCueFillBrush}" Stroke="{StaticResource DropCueStrokeBrush}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                       Width="{Binding DropZoneCenterRect.Width}" Height="{Binding DropZoneCenterRect.Height}"
                       Canvas.Left="{Binding DropZoneCenterRect.Left}" Canvas.Top="{Binding DropZoneCenterRect.Top}" />
            <Rectangle Fill="{StaticResource DropCueFillBrush}" Stroke="{StaticResource DropCueStrokeBrush}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                       Width="{Binding DropZoneLeftRect.Width}" Height="{Binding DropZoneLeftRect.Height}"
                       Canvas.Left="{Binding DropZoneLeftRect.Left}" Canvas.Top="{Binding DropZoneLeftRect.Top}" />
            <Rectangle Fill="{StaticResource DropCueFillBrush}" Stroke="{StaticResource DropCueStrokeBrush}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                       Width="{Binding DropZoneTopRect.Width}" Height="{Binding DropZoneTopRect.Height}"
                       Canvas.Left="{Binding DropZoneTopRect.Left}" Canvas.Top="{Binding DropZoneTopRect.Top}" />
            <Rectangle Fill="{StaticResource DropCueFillBrush}" Stroke="{StaticResource DropCueStrokeBrush}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                       Width="{Binding DropZoneRightRect.Width}" Height="{Binding DropZoneRightRect.Height}"
                       Canvas.Left="{Binding DropZoneRightRect.Left}" Canvas.Top="{Binding DropZoneRightRect.Top}" />
            <Rectangle Fill="{StaticResource DropCueFillBrush}" Stroke="{StaticResource DropCueStrokeBrush}" StrokeThickness="1.5" RadiusX="6" RadiusY="6"
                       Width="{Binding DropZoneBottomRect.Width}" Height="{Binding DropZoneBottomRect.Height}"
                       Canvas.Left="{Binding DropZoneBottomRect.Left}" Canvas.Top="{Binding DropZoneBottomRect.Top}" />
        </Canvas>

    </Canvas>
</UserControl>
